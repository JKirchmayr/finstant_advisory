{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/de/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/de/",
      "permanent": true
    },
    {
      "source": "/de/referenzen",
      "destination": "/de/",
      "permanent": false
    },
    {
      "source": "/de/referenzen/",
      "destination": "/de/",
      "permanent": false
    },
    {
      "source": "/en/references",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/en/references/",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/it/referenze",
      "destination": "/it/",
      "permanent": false
    },
    {
      "source": "/it/referenze/",
      "destination": "/it/",
      "permanent": false
    }
  ]
}
